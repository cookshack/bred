#!/usr/bin/env bash
set -e

if [ $# -gt 0 ]; then
  exec docker exec -it "$1" bash
fi

BRED="$(dirname "$(realpath "$0")")"
AUTH="$HOME/.local/share/opencode/auth.json"
LOCAL_SHARE="$("$BRED/oc-data-dir" "$PWD")"
# Must match containerHome in js/code-mounts.mjs and the image's home.
CHOME=/home/matt

ARGS=(-v "$PWD:$PWD")
for m in \
  "$HOME/fresh/main:$HOME/fresh/main" \
  "$HOME/src/review:$HOME/src/review" \
  "$HOME/src/bred:$HOME/src/bred" \
  "$HOME/sessions:$HOME/sessions" \
  "$HOME/src/opencode:$HOME/src/opencode:ro" \
  "$AUTH:$CHOME/.local/share/opencode/auth.json:ro" \
  "$HOME/.gitignore:$CHOME/.gitignore:ro" \
  "$LOCAL_SHARE:$CHOME/.local/share/opencode"; do
  if [ "${m%%:*}" != "$PWD" ]; then
    ARGS+=(-v "$m")
  fi
done

if [ -f "$HOME/.config/opencode/opencode.json" ]; then
  ARGS+=(-v "$HOME/.config/opencode/opencode.json:$CHOME/.config/opencode/opencode.json:ro")
fi

exec docker run -it --rm --name "bred-code-sh-$$" \
  "${ARGS[@]}" \
  --entrypoint bash \
  -w "$PWD" \
  opencode-bred
