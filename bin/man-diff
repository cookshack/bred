#!/usr/bin/env node

// Compare what js/man-parse.mjs renders with what man(1) prints, over an
// installed corpus. This is a content check, not a layout check: it reports
// reference words that are missing from our text, worst pages first.
//
//   bin/man-diff [--root DIR] [--section N] [--max N] [--min N] [--list]
//   bin/man-diff --page /usr/share/man/man1/ls.1.gz
//
// Exit status is 1 when the report is empty of problems? No: this is a
// diagnostic, so it exits 0 unless it could not run.
//
// --max N reads the first N pages in sorted path order, so a sample is the
// same on every run and filesystem; the report says how much it read. --max 0
// (the default) reads the whole filtered set.

import { execFileSync } from 'node:child_process'
import Fs from 'node:fs'
import Path from 'node:path'
import Zlib from 'node:zlib'

import * as ManParse from '../js/man-parse.mjs'

let opts, stats

function usage
() {
  console.log('usage: man-diff [--root DIR] [--section N] [--max N] [--min N] [--all] [--list] [--page FILE]')
}

function parseArgs
(argv) {
  let out

  out = { root: '/usr/share/man', section: '', max: 0, min: 20, list: 0, page: '', all: 0 }
  for (let i = 0; i < argv.length; i++) {
    let arg

    arg = argv[i]
    if (arg == '--root') {
      i++
      out.root = argv[i]
    }
    else if (arg == '--section') {
      i++
      out.section = argv[i]
    }
    else if (arg == '--max') {
      i++
      out.max = Number(argv[i]) || 0
    }
    else if (arg == '--min') {
      i++
      out.min = Number(argv[i]) || 0
    }
    else if (arg == '--list')
      out.list = 1
    else if (arg == '--all')
      out.all = 1
    else if (arg == '--page') {
      i++
      out.page = argv[i]
    }
    else {
      console.error('unknown argument: ' + arg)
      usage()
      process.exit(2)
    }
  }
  return out
}

function isPage
(file) {
  let name

  name = Path.basename(file).replace(/\.gz$/, '')
  return /\.[0-9][a-z]*$/.test(name) ? 1 : 0
}

function walk
(dir, out, seen) {
  let entries

  if (seen[dir])
    return
  seen[dir] = 1
  try {
    entries = Fs.readdirSync(dir, { withFileTypes: true })
  }
  catch (err) {
    return
  }
  entries.forEach(entry => {
                    let full

                    full = Path.join(dir, entry.name)
                    if (entry.isDirectory())
                      walk(full, out, seen)
                    else if (/^man[0-9]/.test(Path.basename(dir)) && isPage(full) &&
                             Fs.existsSync(full))
                      out.push(full)
                  })
}

function readPage
(file) {
  let buf

  buf = Fs.readFileSync(file)
  if (file.endsWith('.gz'))
    buf = Zlib.gunzipSync(buf)
  return buf.toString('utf8')
}

// Strip backspace overstrikes (bold/underline) and collapse whitespace.
function normal
(text) {
  return text.replace(/.\x08/g, '')
             .replace(/\x1b\[[0-9;]*m/g, '')
             .replace(/[\u2500-\u257f•]/g, ' ')
             .replace(/\s+/g, ' ')
             .trim()
}

function isHeader
(line) {
  // A page name may contain dots, the section may have two digits
  // (`UPDMAP.CFG(20)`), and a page with no section still prints `()`.
  return /[\w.+-]+\([0-9]*[0-9A-Za-z]*\)/.test(line) ? 1 : 0
}

// BSD-style footers have no name(section) in them: "BSD ... October 26, 2022
// ... BSD". Only the last line of the output is tested, and a page's final
// content line does not normally end in a bare date.
function isFooter
(line) {
  return /(19|20)[0-9][0-9]/.test(line) && (line.trim().length < 120) ? 1 : 0
}

// groff hyphenates at line ends with U+2010; join those back together so the
// comparison is about content, not line breaking. An ASCII hyphen also breaks
// a line inside a compound ("git-" + "config(1)"), but only when it is glued
// to a word; a standalone minus ("Note -") is real text and stays separate.
function joinHyphens
(lines) {
  let out

  out = []
  lines.forEach(line => {
                let last

                line = normal(line)
                last = out[out.length - 1]
                if (last != undefined) {
                  if (/[\u2010\u2011]$/.test(last)) {
                    out[out.length - 1] = last.slice(0, -1) + line
                    return
                  }
                  if (/[A-Za-z0-9]-$/.test(last)) {
                    out[out.length - 1] = last + line
                    return
                  }
                }
                out.push(line)
              })
  return out
}

// A page asks groff for a break with no hyphen at `\:`, and the groff pages
// use it inside long paths, so man(1) prints `/usr/` at one line end and
// `lib/groff/site-tmac,` at the next. A line ending in "/" is not enough on
// its own: a finished URL, a regexp or a `/usr/` word at a sentence end looks
// the same. The source says which token the page allowed to break, so only a
// token the source marks with `\:` is joined, and only when it ends in "/":
// that is a path, not prose and not bash(1)'s `:/bin:` in a PATH list.
function breakTokens
(src) {
  let out, re, m, at, run, text

  out = new Set()
  src = src.split('\n').filter(line => /^\.\\"/.test(line) == 0).join('\n')
  re = /\\:/g
  while ((m = re.exec(src)) != undefined) {
    at = m.index
    while ((at > 0) && (/\s/.test(src[at - 1]) == 0))
      at--
    run = src.slice(at, m.index)
    text = run.replace(/\\[:&%\/|]/g, '')
               .replace(/\\-/g, '-')
               .replace(/\\f(\[[^]]*\]|.)/g, '')
               .replace(/\\ /g, ' ')
    text = text.trim().split(' ').pop()
    if (/\/$/.test(text))
      out.add(text)
  }
  return out
}

// A `\:` at the end of a paragraph never breaks, so the following rendered
// line is a new paragraph, not the rest of the word: a blank line between the
// two is the tell (hg(1)'s "http://pygments.org/" is followed by "There").
function joinBreaks
(lines, breaks) {
  let out

  out = []
  lines.forEach(line => {
                let last

                line = normal(line)
                last = out[out.length - 1]
                if ((last != undefined) && line.length &&
                    breakOf(last, breaks).length) {
                  out[out.length - 1] = last + line
                  return
                }
                out.push(line)
              })
  return out
}

// A macro like `.RI ( /usr/...` prints "(" glued to the path, so the rendered
// token can carry a punctuation prefix the source break token does not have.
// Strip leading punctuation only: a letter or digit before the break token
// means the token is a word that merely ends the line.
function breakOf
(line, breaks) {
  let token, at

  token = line.split(' ').pop()
  at = 0
  while (at < token.length) {
    if (breaks.has(token.slice(at)) && (/\/$/.test(token.slice(at))))
      return token.slice(at)
    if (/[A-Za-z0-9]/.test(token[at]))
      return ''
    at++
  }
  return ''
}

// groff hyphenates a long word inside a narrow tbl cell with U+2010 and
// continues it on the next line of the same cell, with the rest of the row
// still on the first line:
//
//     │TIFFTAG_BADFAX‐  │ 1       │ uint32_t*        │
//     │LINES            │         │                  │
//
// joinHyphens only sees a U+2010 at the end of a *line*, so it would keep the
// halves apart and report both missing. Reassemble the cell first, on the raw
// lines where the columns still line up. Only U+2010 may join: an ASCII "-"
// is real text and a space follows it. The continuation must start at or after
// the hyphenated token's column and stay inside the same cell, or it belongs
// to a different column; if there is none the line is left alone.
function cellEnd
(line, at) {
  let i

  i = at
  while (i < line.length) {
    if ((line[i] == '│') || (line[i] == '|'))
      return i
    if ((line[i] == ' ') && (line.slice(i, i + 3) == '   '))
      return i
    i++
  }
  return line.length
}

function cellStart
(line, at) {
  let i

  i = at - 1
  while (i >= 0) {
    if ((line[i] == '│') || (line[i] == '|'))
      return i + 1
    if ((i >= 2) && (line.slice(i - 2, i + 1) == '   '))
      return i + 1
    i--
  }
  return 0
}

function cellToken
(line, at, end) {
  let re, m, from, stop

  from = cellStart(line, at)
  stop = Math.min(end, cellEnd(line, at))
  re = /[^\s│|]+/g
  while ((m = re.exec(line)) != undefined) {
    if (m.index < from)
      continue
    if (m.index >= stop)
      return undefined
    if (m.index < at)
      return undefined
    return { start: m.index, text: m[0] }
  }
  return undefined
}

// A bordered last-column cell wraps at a U+2010 even when its continuation
// starts left of the hyphenated token: TIFFGetField(3) continues
//
//     │ 1   <<  BitsPer‐ │
//     │ Sample arrays    │
//
// from the cell's left edge, so cellToken's "at or after the token's column"
// rule refuses it. With borders the cell is unambiguous: take the first token
// of the next line between the same two border columns. Prose has no border,
// so this cannot reach into a filled paragraph. Returns undefined when the
// next line does not line up or has no token in the cell.
function borderToken
(line, next, at, end) {
  let left, re, m, i

  if ((line[end] != '│') && (line[end] != '|'))
    return undefined
  left = -1
  for (i = at - 1; i >= 0; i--) {
    if ((line[i] == '│') || (line[i] == '|')) {
      left = i
      break
    }
  }
  if (left < 0)
    return undefined
  if ((next == undefined) || (next[left] != line[left]) ||
      (next[end] != line[end]))
    return undefined
  re = /[^\s│|]+/g
  while ((m = re.exec(next)) != undefined) {
    if (m.index <= left)
      continue
    if (m.index >= end)
      return undefined
    return { start: m.index, text: m[0] }
  }
  return undefined
}

function joinCells
(lines) {
  let out

  out = lines.map(line => line.replace(/.\x08/g, '').replace(/\x1b\[[0-9;]*m/g, ''))
  for (let i = 0; i + 1 < out.length; i++) {
    let re, m, joins

    joins = []
    re = /[^\s│|]+/g
    while ((m = re.exec(out[i])) != undefined) {
      let start, token, end, next, text, j, bordered

      start = m.index
      token = m[0]
      if (/[\u2010]$/.test(token) == 0)
        continue
      end = cellEnd(out[i], start + token.length)
      bordered = ((out[i][end] == '│') || (out[i][end] == '|')) ? 1 : 0
      if (bordered == 0) {
        // A prose line also ends in U+2010, but its first token is not the
        // hyphenated one; only a cell whose content starts here continues on
        // the next line. Checking for text before the token keeps the next
        // line's sentence-spacing gap from looking like a cell boundary.
        if (out[i].slice(cellStart(out[i], start), start).trim().length)
          continue
        // A hyphenated token whose cell runs to the end of the line is prose
        // broken at the right margin, not a table cell: a table row still has
        // the rest of the row (another column or a border) after the cell.
        // Without this, the justification gaps of a filled paragraph read as
        // cell boundaries and the join steals a word from the next line
        // (hgrc(5)'s "format." became "for" + "the").
        if (end == out[i].length)
          continue
      }
      if (out[i].slice(start + token.length, end).trim().length)
        continue
      next = undefined
      if (bordered)
        next = borderToken(out[i], out[i + 1], start, end)
      else
        next = cellToken(out[i + 1], start, end)
      if (next == undefined)
        continue
      text = next.text
      j = i + 1
      out[j] = out[j].slice(0, next.start) + ' '.repeat(text.length) +
               out[j].slice(next.start + text.length)
      while (/[\u2010]$/.test(text)) {
        next = undefined
        if (bordered)
          next = borderToken(out[j], out[j + 1], start, end)
        else
          next = cellToken(out[j + 1], start, end)
        if (next == undefined)
          break
        text = text.slice(0, -1) + next.text
        j++
        out[j] = out[j].slice(0, next.start) + ' '.repeat(next.text.length) +
                 out[j].slice(next.start + next.text.length)
      }
      joins.push({ start, token, text })
    }
    joins.reverse().forEach(join => {
                            out[i] = out[i].slice(0, join.start) + join.token.slice(0, -1) +
                                     join.text + out[i].slice(join.start + join.token.length)
                          })
  }
  return out
}

function referenceText
(file, src) {
  let text, lines, out

  text = execFileSync('man', [ '-Tutf8', file ], { encoding: 'utf8',
                                                   stdio: [ 'ignore', 'pipe', 'ignore' ] })
  lines = text.split('\n')
  while (lines.length && (lines[0].trim() == ''))
    lines.shift()
  if (lines.length && isHeader(lines[0]))
    lines.shift()
  while (lines.length && lines[lines.length - 1].trim() == '')
    lines.pop()
  if (lines.length && isHeader(lines[lines.length - 1]))
    lines.pop()
  else if (lines.length && isFooter(lines[lines.length - 1]))
    lines.pop()
  out = joinHyphens(joinBreaks(joinCells(lines), breakTokens(src))).join('\n')
  return normal(out)
}

function wordsOf
(text) {
  return text.split(' ').filter(word => word.length)
}

// man(1) lays text out in 78 columns, so a sentence that ends with a long URL
// can push the final "." onto a line of its own. The reference then has the
// word and a punctuation-only token where our text has one word with the
// period attached, and neither side is more right: the period is the end of the
// sentence, not content. Trailing sentence punctuation is therefore left out of
// the word's key, so "foo." and "foo" compare equal, and a token that is only
// punctuation has an empty key and drops out of both sides. The token keeps its
// period in the report, and a bracket stays part of its word.
function keyOf
(word) {
  return word.replace(/[.,;:!?]+$/, '')
}

// toText joins table cells with " | " and keeps a `_` rule row; man(1) draws
// neither. Both sides drop those tokens so a real "|" in an example cannot
// look like a table border on one side only.
function ourWordsOf
(text) {
  return wordsOf(text).filter(word => (word != '|') && (word != '_'))
}

function missingWords
(refWords, ourWords) {
  let counts, missing, sample

  counts = new Map()
  ourWords.forEach(word => {
                     let key

                     key = keyOf(word)
                     if (key.length)
                       counts.set(key, (counts.get(key) || 0) + 1)
                   })
  missing = 0
  sample = []
  refWords.forEach(word => {
                     let key, left

                     key = keyOf(word)
                     if (key.length == 0)
                       return
                     left = counts.get(key) || 0
                     if (left > 0)
                       counts.set(key, left - 1)
                     else {
                       missing++
                       if ((sample.length < 8) && (sample.includes(word) == 0))
                         sample.push(word)
                     }
                   })
  return { missing, sample }
}

function diffPage
(file) {
  let src, res, ref, ours

  src = readPage(file)
  res = ManParse.parse(src)
  if (res.ok == 0)
    return { file, refused: 1, fails: res.fails }
  ref = ourWordsOf(referenceText(file, src))
  ours = ourWordsOf(normal(ManParse.toText(res.doc.blocks)))
  if (ref.length < opts.min)
    return { file, small: 1, refWords: ref.length }
  return { file,
           refWords: ref.length,
           ourWords: ours.length,
           ...missingWords(ref, ours) }
}

function detail
(file) {
  let src, res, ref, ours, a, b, at

  src = readPage(file)
  res = ManParse.parse(src)
  console.log('file  ' + file)
  console.log('ok    ' + res.ok)
  if (res.ok == 0) {
    console.log('fails ' + res.fails.map(item => item.what + '@' + item.line).join(', '))
    return
  }
  ref = ourWordsOf(referenceText(file, src))
  ours = ourWordsOf(normal(ManParse.toText(res.doc.blocks)))
  at = 0
  while ((at < ref.length) && (at < ours.length) && (ref[at] == ours[at]))
    at++
  console.log('words ' + ours.length + ' ours / ' + ref.length + ' man')
  console.log('at    ' + at)
  console.log('ours  ' + JSON.stringify(ours.slice(Math.max(0, at - 3), at + 8)))
  console.log('man   ' + JSON.stringify(ref.slice(Math.max(0, at - 3), at + 8)))
  console.log('lost  ' + JSON.stringify(missingWords(ref, ours).sample))
}

opts = parseArgs(process.argv.slice(2))

if (opts.page) {
  detail(opts.page)
  process.exit(0)
}

stats = { pages: 0, total: 0, compared: 0, refused: 0, small: 0, noisy: 0, missing: 0, worst: [] }

{
  let files

  files = []
  walk(opts.root, files, {})
  if (opts.all == 0)
    files = files.filter(file => Path.dirname(Path.dirname(file)) == opts.root)
  if (opts.section)
    files = files.filter(file => Path.basename(Path.dirname(file)) == ('man' + opts.section))
  // readdir order differs between runs and filesystems, so a --max sample has
  // to be sorted to be repeatable. Keep the full count: the sample is not the
  // section, and saying which part was read is the point of the report.
  files.sort()
  stats.total = files.length
  if (opts.max)
    files = files.slice(0, opts.max)
  files.forEach(file => {
                   let out

                   stats.pages++
                   try {
                     out = diffPage(file)
                   }
                   catch (err) {
                     stats.refused++
                     return
                   }
                   if (out.refused) {
                     stats.refused++
                     return
                   }
                   if (out.small) {
                     stats.small++
                     return
                   }
                   stats.compared++
                   if (out.missing == 0)
                     return
                   stats.noisy++
                   stats.missing += out.missing
                   stats.worst.push(out)
                 })
}

stats.worst.sort((a, b) => b.missing - a.missing)
console.log('man-diff')
console.log('')
console.log('  pages     ' + stats.pages +
            ((stats.pages < stats.total) ? (' of ' + stats.total + '  (sample; --max 0 for all)') : ''))
console.log('  compared  ' + stats.compared + '  (refused ' + stats.refused +
            ', too small ' + stats.small + ')')
console.log('  pages with missing words  ' + stats.noisy +
            '  (' + stats.missing + ' words total)')
if (stats.worst.length) {
  console.log('')
  console.log('worst:')
  stats.worst.slice(0, opts.list ? 500 : 20).forEach(out => {
                                                      console.log('  ' + String(out.missing).padStart(5) +
                                                                  '  ' + out.file.replace(opts.root, '') +
                                                                  '  ' + JSON.stringify(out.sample))
                                                    })
}
