#!/usr/bin/env node

// Compare what js/man-parse.mjs renders with what man(1) prints, over an
// installed corpus. This is a content check, not a layout check: it reports
// reference words that are missing from our text, worst pages first.
//
//   bin/man-diff [--root DIR] [--section N] [--max N] [--min N] [--list]
//   bin/man-diff --page /usr/share/man/man1/ls.1.gz
//
// Exit status is 1 when the report is empty of problems? No: this is a
// diagnostic, so it exits 0 unless it could not run.
//
// --max N reads the first N pages in sorted path order, so a sample is the
// same on every run and filesystem; the report says how much it read. --max 0
// (the default) reads the whole filtered set.

import { execFileSync } from 'node:child_process'
import Fs from 'node:fs'
import Path from 'node:path'
import Url from 'node:url'
import Zlib from 'node:zlib'

import * as ManParse from '../js/man-parse.mjs'

let opts, stats

function usage
() {
  console.log('usage: man-diff [--root DIR] [--section N] [--max N] [--min N] [--all] [--list] [--page FILE]')
}

function parseArgs
(argv) {
  let out

  out = { root: '/usr/share/man', section: '', max: 0, min: 20, list: 0, page: '', all: 0 }
  for (let i = 0; i < argv.length; i++) {
    let arg

    arg = argv[i]
    if (arg == '--root') {
      i++
      out.root = argv[i]
    }
    else if (arg == '--section') {
      i++
      out.section = argv[i]
    }
    else if (arg == '--max') {
      i++
      out.max = Number(argv[i]) || 0
    }
    else if (arg == '--min') {
      i++
      out.min = Number(argv[i]) || 0
    }
    else if (arg == '--list')
      out.list = 1
    else if (arg == '--all')
      out.all = 1
    else if (arg == '--page') {
      i++
      out.page = argv[i]
    }
    else {
      console.error('unknown argument: ' + arg)
      usage()
      process.exit(2)
    }
  }
  return out
}

function isPage
(file) {
  let name

  name = Path.basename(file).replace(/\.gz$/, '')
  return /\.[0-9][a-z]*$/.test(name) ? 1 : 0
}

function walk
(dir, out, seen) {
  let entries

  if (seen[dir])
    return
  seen[dir] = 1
  try {
    entries = Fs.readdirSync(dir, { withFileTypes: true })
  }
  catch (err) {
    return
  }
  entries.forEach(entry => {
                    let full

                    full = Path.join(dir, entry.name)
                    if (entry.isDirectory())
                      walk(full, out, seen)
                    else if (/^man[0-9]/.test(Path.basename(dir)) && isPage(full) &&
                             Fs.existsSync(full))
                      out.push(full)
                  })
}

function readPage
(file) {
  let buf

  buf = Fs.readFileSync(file)
  if (file.endsWith('.gz'))
    buf = Zlib.gunzipSync(buf)
  return buf.toString('utf8')
}

// Strip backspace overstrikes (bold/underline) and collapse whitespace.
function normal
(text) {
  return text.replace(/.\x08/g, '')
             .replace(/\x1b\[[0-9;]*m/g, '')
             .replace(/[\u2500-\u257f•]/g, ' ')
             .replace(/\s+/g, ' ')
             .trim()
}

// A long name is truncated in the running header to `NAME...` with no
// `(section)` left on it (crypt_preferred_method(3), four rpc_gss_*(3)), so
// the pattern alone would leave the banner in as content. The page's own name
// is known from its path: both halves of the banner are that name truncated,
// and the section volume title still says `Manual`. Requiring all three keeps
// a content line from matching.
function isHeader
(line, name) {
  let upper

  // A page name may contain dots, the section may have two digits
  // (`UPDMAP.CFG(20)`), and a page with no section still prints `()`.
  if (/[\w.+-]+\([0-9]*[0-9A-Za-z]*\)/.test(line))
    return 1
  if ((name == undefined) || (/Manual/.test(line) == 0))
    return 0
  upper = name.toUpperCase()
  return line.split(/\s+/).some(word => /\.\.\.$/.test(word) &&
                                       (word.length > 3) &&
                                       upper.startsWith(word.slice(0, -3).toUpperCase())) ? 1 : 0
}

function pageName
(file) {
  return Path.basename(file).replace(/\.gz$/, '').replace(/\.[0-9][A-Za-z]*$/, '')
}

// BSD-style footers have no name(section) in them: "BSD ... October 26, 2022
// ... BSD". Only the last line of the output is tested, and a page's final
// content line does not normally end in a bare date.
//
// an-old.tmac's multi-page footer is a page string too. Its `an-p-footer`
// names a page `\nX` followed by the page letter whenever the `X` register
// exists, and rpcgen(1) writes a bare `.nr X` that `.if \nX=0` then reads as
// 0, so man(1) ends the page with `0a`. `BT` prints it right-aligned in the
// third field of the footer title line, flush with the 78-column right margin.
// A token deeper in an indented content line therefore does not match, and the
// rule can only drop a word from the end of a page, never invent one.
export function isFooter
(line) {
  if (/(19|20)[0-9][0-9]/.test(line) && (line.trim().length < 120))
    return 1
  return (/^\s{10,}[0-9]+[a-z]$/.test(line) && (line.length >= 70)) ? 1 : 0
}

// groff hyphenates at line ends with U+2010; join those back together so the
// comparison is about content, not line breaking. An ASCII hyphen also breaks
// a line inside a compound ("git-" + "config(1)"), but only when it is glued
// to a word; a standalone minus ("Note -") is real text and stays separate.
//
// A rendered ASCII-hyphen line end has two causes and only the source tells
// them apart: a compound broken at the hyphen (`[n]<&digit-` + `moves`) and a
// word that already ends in a hyphen, where man(1) broke the line at the space
// after it ("byte\- and" renders as "byte-" at one line end and "and" at the
// next). Joining the second invents "byte-and". spacedHyphens names the pairs
// whose source writes the space, so the join can leave them alone. The pairs
// actually joined are returned too: our text is not laid out, so glueWords can
// make the same joins on our side.
//
// An em dash is a break opportunity of its own, with no hyphen glyph: man(1)
// prints gittutorial-2(7)'s `ways\(emby` as `ways—` at one line end and `by`
// at the next. The same source check applies, since gitworkflows(7) writes
// `basis \(em is` and there the printed line end is a dash token, not half of
// a word. spacedDashes names the pairs whose source spaced the dash.
function joinHyphens
(lines, spaced) {
  let out, glued

  out = []
  glued = new Set()
  lines.forEach(line => {
                let last, token, next

                line = normal(line)
                last = out[out.length - 1]
                if (last != undefined) {
                  if (/[\u2010\u2011]$/.test(last)) {
                    out[out.length - 1] = last.slice(0, -1) + line
                    return
                  }
                  if (/[A-Za-z0-9]-$/.test(last)) {
                    token = last.split(' ').pop()
                    next = line.split(' ')[0]
                    if (spaced.has(token + ' ' + next) == 0) {
                      glued.add(token + ' ' + next)
                      out[out.length - 1] = last + line
                      return
                    }
                  }
                  if (/\u2014$/.test(last) && line.length) {
                    token = last.split(' ').pop()
                    next = line.split(' ')[0]
                    if (spaced.has(token + ' ' + next) == 0) {
                      glued.add(token + ' ' + next)
                      out[out.length - 1] = last + line
                      return
                    }
                  }
                }
                out.push(line)
              })
  return { lines: out, glued }
}

// The page source is the only side that knows a hyphen is a word boundary:
// `byte\- and` is two words that man(1) happened to break between, while
// `paren-` at the end of a `.nf` line is one word broken for layout. Record
// the "word- nextword" pairs whose source carries whitespace after the
// hyphen. A hyphen at the end of a source line is not one: the newline is the
// break, not a space. Font and other escapes are stripped first, both before
// the hyphen (`\fBbyte\fP\- and`) and after it (`and\fP`), so the pair matches
// what the rendered lines hold. `\-` is the ASCII hyphen; `\(hy` too.
function spacedHyphens
(src) {
  let out, text, re, m, next

  out = new Set()
  text = src.split('\n').filter(line => /^\.\\"/.test(line) == 0).join('\n')
  text = text.replace(/\\-/g, '-')
             .replace(/\\\(hy/g, '-')
             .replace(/\\f(\[[^]]*\]|.)/g, '')
             .replace(/\\[:&%\/|]/g, '')
  re = /([A-Za-z0-9]+)-[ \t]+/g
  while ((m = re.exec(text)) != undefined) {
    next = text.slice(m.index + m[0].length).split(/\s/)[0]
    if (next.length)
      out.add(m[1] + '- ' + next)
  }
  return out
}

// An em dash is its own break opportunity: `\(em` needs no hyphen glyph and
// groff may print it at a line end. The source still says whether the dash is
// inside a word or stands between two: `ways\(emby` glues it to both sides,
// while `basis \(em is` has whitespace around it and man(1) prints the dash as
// a token at the line end. Only whitespace *after* the dash separates the two,
// so record the rendered pair for every dash whose source carries it: the word
// glued to the dash ("ways— by") or the bare dash ("— is") when a space comes
// before it too. joinHyphens then leaves those line ends alone. A newline
// after the dash counts as whitespace here, unlike the hyphen case: in filled
// text a source newline is a space, so `console \(em` at a source line end
// prints a spaced dash, not a word broken for layout.
function spacedDashes
(src) {
  let out, text, re, m, next, before

  out = new Set()
  text = src.split('\n').filter(line => /^\.\\"/.test(line) == 0).join('\n')
  text = text.replace(/\\\(em/g, '\u2014')
             .replace(/\\f(\[[^]]*\]|.)/g, '')
             .replace(/\\[:&%\/|]/g, '')
  re = /\u2014\s+/g
  while ((m = re.exec(text)) != undefined) {
    next = text.slice(m.index + m[0].length).split(/\s/)[0]
    if (next.length == 0)
      continue
    before = /[^\s]*$/.exec(text.slice(0, m.index))[0]
    if (before.length)
      out.add(before + '\u2014 ' + next)
    else
      out.add('\u2014 ' + next)
  }
  return out
}

// A page asks groff for a break with no hyphen at `\:`, and the groff pages
// use it inside long paths, so man(1) prints `/usr/` at one line end and
// `lib/groff/site-tmac,` at the next. The source says which token the page
// allowed to break, so only a token the source marks with `\:` is joined.
// The mark alone is not enough: hg(1) writes `\%\fBhg help urls\fP\:` in prose,
// where the mark is a break opportunity inside a sentence and the token is an
// ordinary word, and joining at those would destroy the comparison (367 words
// on hg(1) alone). What separates them is the character the break follows: a
// path or address separator, `/`, `:` or `@`. bash(1) breaks its PATH list
// after ":" and troff(1) an address after "@".
//
// ps(1) marks the commas inside a comma-separated option list the same way,
// `-o pid,\:format,\:tname,\:time,\:cmd`, so man(1) can break the argument
// after a comma and print `pid,format,tname,` at one line end, `time,cmd,` at
// the next. A comma is also plain prose punctuation, so the comma alone cannot
// be the marker: a prose comma is followed by whitespace in the source, while
// a list's comma escapes straight into the next field with none. Only a `\:`
// immediately after a comma and immediately before more text is joined, and
// only when the whole rendered token matches the source run, so "word, next"
// stays two words.
//
// dmsetup(8) marks two more inside-token breaks on its syntax lines. A `|`
// separates the alternatives of a bracketed option, and a `]` closes a nested
// group: `[--addnodeoncreate |\: --addnodeonresume]` and
// `<table>\:[,<table>+]\:[;<dev_name>`. man(1) then prints the token across
// two lines (`[--addnodeoncreate|` / `--addnodeonresume]`). The pipe is a
// macro argument of its own in the source, so the whitespace before it is not
// printed; the run has to be widened to the word before the pipe to match the
// rendered token, and only a whole-token match in breakOf can use it. The `]`
// is like the comma: a closing bracket followed by text is inside the token,
// while one followed by whitespace ends an ordinary word.
function breakTokens
(src) {
  let out, re, m, at, run, text, after, from

  out = new Set()
  src = src.split('\n').filter(line => /^\.\\"/.test(line) == 0).join('\n')
  re = /\\:/g
  while ((m = re.exec(src)) != undefined) {
    at = m.index
    while ((at > 0) && (/\s/.test(src[at - 1]) == 0))
      at--
    run = src.slice(at, m.index)
    text = run.replace(/\\[:&%\/|]/g, '')
               .replace(/\\-/g, '-')
               .replace(/\\f(\[[^]]*\]|.)/g, '')
               .replace(/\\ /g, ' ')
    text = text.trim().split(' ').pop()
    if ((text == '|') && (at > 0)) {
      from = at - 1
      while ((from > 0) && /\s/.test(src[from - 1]))
        from--
      while ((from > 0) && (/\s/.test(src[from - 1]) == 0))
        from--
      text = src.slice(from, at)
                .replace(/\\[:&%\/|]/g, '')
                .replace(/\\-/g, '-')
                .replace(/\\f(\[[^]]*\]|.)/g, '')
                .replace(/\\ /g, ' ')
                .trim() + '|'
    }
    if (/[/:@]$/.test(text))
      out.add(text)
    else if (/\|$/.test(text)) {
      if (text.length > 1)
        out.add(text)
    }
    else if (/\]$/.test(text)) {
      after = src[m.index + 2]
      if ((text.length > 1) && (after != undefined) && (/\s/.test(after) == 0))
        out.add(text)
    }
    else if (/,$/.test(text)) {
      after = src[m.index + 2]
      if ((after != undefined) && (/\s/.test(after) == 0))
        out.add(text)
    }
  }
  return out
}

// hg(1) writes `\fP\:)`: the break point sits immediately before a closing
// paren. The token before it is not distinctive enough to join on (a line
// ending "incoming" is common), so this set is only used when the *next*
// rendered line starts with `)`, which is the shape the break leaves.
function parenTokens
(src) {
  let out, re, m

  out = new Set()
  re = /\\:/g
  src = src.split('\n').filter(line => /^\.\\"/.test(line) == 0).join('\n')
  while ((m = re.exec(src)) != undefined) {
    if (src[m.index + 2] == ')') {
      let at, text

      at = m.index
      while ((at > 0) && (/\s/.test(src[at - 1]) == 0))
        at--
      text = src.slice(at, m.index).replace(/\\[:&%\/|]/g, '')
                 .replace(/\\-/g, '-')
                 .replace(/\\f(\[[^]]*\]|.)/g, '')
                 .replace(/\\ /g, ' ')
      text = text.trim().split(' ').pop()
      if (text.length > 1)
        out.add(text)
    }
  }
  return out
}

// A `\:` at the end of a paragraph never breaks, so the following rendered
// line is a new paragraph, not the rest of the word: a blank line between the
// two is the tell (hg(1)'s "http://pygments.org/" is followed by "There").
function joinBreaks
(lines, breaks, parens) {
  let out

  out = []
  lines.forEach(line => {
                let last

                line = normal(line)
                last = out[out.length - 1]
                if ((last != undefined) && line.length &&
                    breakOf(last, breaks).length) {
                  out[out.length - 1] = last + line
                  return
                }
                if ((last != undefined) && line.startsWith(')') &&
                    parens.has(last.split(' ').pop())) {
                  out[out.length - 1] = last + line
                  return
                }
                out.push(line)
              })
  return out
}

// A macro like `.RI ( /usr/...` prints "(" glued to the path, so the rendered
// token can carry a punctuation prefix the source break token does not have.
// Strip leading punctuation only: a letter or digit before the break token
// means the token is a word that merely ends the line. breakTokens has already
// kept only tokens that follow a path or address separator.
function breakOf
(line, breaks) {
  let token, at

  token = line.split(' ').pop()
  at = 0
  while (at < token.length) {
    if (breaks.has(token.slice(at)))
      return token.slice(at)
    if (/[A-Za-z0-9]/.test(token[at]))
      return ''
    at++
  }
  return ''
}

// groff hyphenates a long word inside a narrow tbl cell with U+2010 and
// continues it on the next line of the same cell, with the rest of the row
// still on the first line:
//
//     │TIFFTAG_BADFAX‐  │ 1       │ uint32_t*        │
//     │LINES            │         │                  │
//
// joinHyphens only sees a U+2010 at the end of a *line*, so it would keep the
// halves apart and report both missing. Reassemble the cell first, on the raw
// lines where the columns still line up. Only U+2010 may join: an ASCII "-"
// is real text and a space follows it. The continuation must stay inside the
// same cell, or it belongs to a different column; if there is none the line is
// left alone.
//
// A cell can hold more than one word, so the hyphenated token is not always
// the cell's first: man(1)'s character table wraps "continuation hyphen" as
//
//     continuation hy‐    255      ‐        -
//     phen
//
// where the cell starts at "continuation". tbl wraps a cell's content to the
// cell's own left edge, so a cell with a word before the hyphenated token
// continues with the first token of the next line inside the cell, wherever
// that token sits; a cell whose content starts at the hyphenated token
// continues at or after that token's column.
function cellEnd
(line, at) {
  let i

  i = at
  while (i < line.length) {
    if ((line[i] == '│') || (line[i] == '|'))
      return i
    if ((line[i] == ' ') && (line.slice(i, i + 3) == '   '))
      return i
    i++
  }
  return line.length
}

function cellStart
(line, at) {
  let i

  i = at - 1
  while (i >= 0) {
    if ((line[i] == '│') || (line[i] == '|'))
      return i + 1
    if ((i >= 2) && (line.slice(i - 2, i + 1) == '   '))
      return i + 1
    i--
  }
  return 0
}

// A cell with a word before the hyphenated token has its content start at the
// cell's left edge, so with `lead` set the continuation is the first token of
// the next line inside the cell even when it starts left of the hyphenated
// token. A prose line also ends in U+2010, but its cell runs to the end of the
// line and joinCells leaves it to joinHyphens.
function cellToken
(line, at, end, lead) {
  let re, m, from, stop

  from = cellStart(line, at)
  stop = Math.min(end, cellEnd(line, at))
  re = /[^\s│|]+/g
  while ((m = re.exec(line)) != undefined) {
    if (m.index < from)
      continue
    if (m.index >= stop)
      return undefined
    if (m.index < (lead ? from : at))
      return undefined
    return { start: m.index, text: m[0] }
  }
  return undefined
}

// A bordered last-column cell wraps at a U+2010 even when its continuation
// starts left of the hyphenated token: TIFFGetField(3) continues
//
//     │ 1   <<  BitsPer‐ │
//     │ Sample arrays    │
//
// from the cell's left edge, so cellToken's "at or after the token's column"
// rule refuses it. With borders the cell is unambiguous: take the first token
// of the next line between the same two border columns. Prose has no border,
// so this cannot reach into a filled paragraph. Returns undefined when the
// next line does not line up or has no token in the cell.
function borderToken
(line, next, at, end) {
  let left, re, m, i

  if ((line[end] != '│') && (line[end] != '|'))
    return undefined
  left = -1
  for (i = at - 1; i >= 0; i--) {
    if ((line[i] == '│') || (line[i] == '|')) {
      left = i
      break
    }
  }
  if (left < 0)
    return undefined
  if ((next == undefined) || (next[left] != line[left]) ||
      (next[end] != line[end]))
    return undefined
  re = /[^\s│|]+/g
  while ((m = re.exec(next)) != undefined) {
    if (m.index <= left)
      continue
    if (m.index >= end)
      return undefined
    return { start: m.index, text: m[0] }
  }
  return undefined
}

function joinCells
(lines) {
  let out

  out = lines.map(line => line.replace(/.\x08/g, '').replace(/\x1b\[[0-9;]*m/g, ''))
  for (let i = 0; i + 1 < out.length; i++) {
    let re, m, joins

    joins = []
    re = /[^\s│|]+/g
    while ((m = re.exec(out[i])) != undefined) {
      let start, token, end, next, text, j, bordered, lead

      start = m.index
      token = m[0]
      if (/[\u2010]$/.test(token) == 0)
        continue
      end = cellEnd(out[i], start + token.length)
      bordered = ((out[i][end] == '│') || (out[i][end] == '|')) ? 1 : 0
      if (bordered == 0) {
        // A hyphenated token whose cell runs to the end of the line is prose
        // broken at the right margin, not a table cell: a table row still has
        // the rest of the row (another column or a border) after the cell.
        // Without this, the justification gaps of a filled paragraph read as
        // cell boundaries and the join steals a word from the next line
        // (hgrc(5)'s "format." became "for" + "the").
        if (end == out[i].length)
          continue
      }
      if (out[i].slice(start + token.length, end).trim().length)
        continue
      lead = out[i].slice(cellStart(out[i], start), start).trim().length
      next = undefined
      if (bordered)
        next = borderToken(out[i], out[i + 1], start, end)
      else
        next = cellToken(out[i + 1], start, end, lead)
      if (next == undefined)
        continue
      text = next.text
      j = i + 1
      out[j] = out[j].slice(0, next.start) + ' '.repeat(text.length) +
               out[j].slice(next.start + text.length)
      while (/[\u2010]$/.test(text)) {
        next = undefined
        if (bordered)
          next = borderToken(out[j], out[j + 1], start, end)
        else
          next = cellToken(out[j + 1], start, end, lead)
        if (next == undefined)
          break
        text = text.slice(0, -1) + next.text
        j++
        out[j] = out[j].slice(0, next.start) + ' '.repeat(next.text.length) +
                 out[j].slice(next.start + next.text.length)
      }
      joins.push({ start, token, text })
    }
    joins.reverse().forEach(join => {
                            out[i] = out[i].slice(0, join.start) + join.token.slice(0, -1) +
                                     join.text + out[i].slice(join.start + join.token.length)
                          })
  }
  return out
}

function referenceText
(file, src) {
  let text, lines, out, name, joined, spaced

  text = execFileSync('man', [ '-Tutf8', file ], { encoding: 'utf8',
                                                   stdio: [ 'ignore', 'pipe', 'ignore' ] })
  lines = text.split('\n')
  name = pageName(file)
  while (lines.length && (lines[0].trim() == ''))
    lines.shift()
  if (lines.length && isHeader(lines[0], name))
    lines.shift()
  while (lines.length && lines[lines.length - 1].trim() == '')
    lines.pop()
  if (lines.length && isHeader(lines[lines.length - 1], name))
    lines.pop()
  else if (lines.length && isFooter(lines[lines.length - 1]))
    lines.pop()
  spaced = spacedHyphens(src)
  spacedDashes(src).forEach(pair => spaced.add(pair))
  joined = joinHyphens(joinBreaks(joinCells(lines), breakTokens(src), parenTokens(src)), spaced)
  out = normal(joined.lines.join('\n'))
  return { text: out, glued: joined.glued }
}

function wordsOf
(text) {
  return text.split(' ').filter(word => word.length)
}

// thumbpdf(1) is the corpus's one page whose source is not valid UTF-8: it
// writes a lone C2 byte (`\302` in groff's octal notation) before the copyright
// glyph: `Copyright \302\[co] 1999`. groff's preconv reads that byte as Latin-1
// and prints `Â©` (C3 82 C2 A9); our UTF-8 decode marks it U+FFFD and prints
// `�©` (EF BF BD C2 A9). The bytes spell the single character `©`, so the key
// folds both spellings to it: our replacement mark drops, and a word made only
// of byte-sized characters is read back as the UTF-8 those bytes spell. Only a
// valid sequence folds; a pair that is still not valid UTF-8 keeps its own key,
// so a real difference is still reported.
function foldBytes
(word) {
  let text

  if (/^[\u0000-\u00ff]*$/.test(word) == 0)
    return word
  try {
    text = new TextDecoder('utf-8', { fatal: 1 }).decode(Buffer.from(word, 'latin1'))
  }
  catch (err) {
    return word
  }
  return text
}

// man(1) lays text out in 78 columns, so a sentence that ends with a long URL
// can push the final "." onto a line of its own. The reference then has the
// word and a punctuation-only token where our text has one word with the
// period attached, and neither side is more right: the period is the end of the
// sentence, not content. Trailing sentence punctuation is therefore left out of
// the word's key, so "foo." and "foo" compare equal, and a token that is only
// punctuation has an empty key and drops out of both sides. The token keeps its
// period in the report, and a bracket stays part of its word.
//
// A no-.TH page gets no an-old.tmac from groff, so man(1) leaves a bare `-` to
// the default utf8 mapping and prints U+2010; a source `\-` can likewise reach
// us as U+2212. For a word comparison those are the ASCII hyphen, so fold them
// in the key. The report keeps the character the reference printed.
//
// The same page's quotes go through the same default mapping: a backtick
// prints as U+2018 and `'` as U+2019 (a doubled backtick stays two U+2018
// rather than forming U+201C, which only the `\(lq`/`\(rq` glyphs do). Our
// text carries the ASCII the source wrote, so fold the typographic quotes
// back to it — U+2018 to the backtick it came from, not to an apostrophe. A
// quote is not sentence punctuation, so the fold has to happen before the
// strip: the apostrophe in "wasn't" is part of the word, not a trailing mark.
//
// mendex(1) gives a value as `"\t\t"`. groff's `\t` is zero width, so man(1)
// prints `""`, while our text keeps the tabs and normal() turns the run into a
// space, splitting the pair into two `"` tokens. Either way the tokens hold
// nothing but double quotes, and a quote is punctuation: a token that is only
// quote marks carries no content, so its key is empty and it drops out of both
// sides, like `.` or `,`. That can only lower a report, never invent a word.
// awk(1)'s escape table prints `"` and `"` around literal tabs the same way,
// and both sides drop there too.
export function keyOf
(word) {
  return foldBytes(word.replace(/\ufffd/g, ''))
             .replace(/[\u2010\u2011\u2212]/g, '-')
             .replace(/\u2018/g, '`')
             .replace(/\u2019/g, "'")
             .replace(/[\u201c\u201d]/g, '"')
             .replace(/[.,;:!?]+$/, '')
             .replace(/^"+$/, '')
}

// toText joins table cells with " | " and keeps a `_` rule row; man(1) draws
// neither. Both sides drop those tokens so a real "|" in an example cannot
// look like a table border on one side only.
//
// Our text is also not laid out. A `.nf` cell that man(1) breaks at `paren-`
// reaches us with the cell padding as a run of spaces, so the comparison sees
// two words there while the reference rejoined them into one. The reference
// is the side that knows where a line was broken, so joinHyphens reports the
// pairs it joined and the same pairs are joined here: the two sides cannot
// drift, and a hyphen that man(1) did not join ("byte- and") stays two words
// on both.
function glueWords
(words, glued) {
  let out, i, word

  out = []
  i = 0
  while (i < words.length) {
    word = words[i]
    while ((i + 1 < words.length) && glued.has(word + ' ' + words[i + 1])) {
      word = word + words[i + 1]
      i++
    }
    out.push(word)
    i++
  }
  return out
}

function ourWordsOf
(text, glued) {
  return glueWords(wordsOf(text).filter(word => (word != '|') && (word != '_')), glued)
}

function missingWords
(refWords, ourWords) {
  let counts, missing, sample

  counts = new Map()
  ourWords.forEach(word => {
                     let key

                     key = keyOf(word)
                     if (key.length)
                       counts.set(key, (counts.get(key) || 0) + 1)
                   })
  missing = 0
  sample = []
  refWords.forEach(word => {
                     let key, left

                     key = keyOf(word)
                     if (key.length == 0)
                       return
                     left = counts.get(key) || 0
                     if (left > 0)
                       counts.set(key, left - 1)
                     else {
                       missing++
                       if ((sample.length < 8) && (sample.includes(word) == 0))
                         sample.push(word)
                     }
                   })
  return { missing, sample }
}

function diffPage
(file) {
  let src, res, head, ref, ours

  src = readPage(file)
  res = ManParse.parse(src)
  if (res.ok == 0)
    return { file, refused: 1, fails: res.fails }
  head = referenceText(file, src)
  ref = ourWordsOf(head.text, head.glued)
  ours = ourWordsOf(normal(ManParse.toText(res.doc.blocks)), head.glued)
  if (ref.length < opts.min)
    return { file, small: 1, refWords: ref.length }
  return { file,
           refWords: ref.length,
           ourWords: ours.length,
           ...missingWords(ref, ours) }
}

function detail
(file) {
  let src, res, head, ref, ours, a, b, at, lost

  src = readPage(file)
  res = ManParse.parse(src)
  console.log('file  ' + file)
  console.log('ok    ' + res.ok)
  if (res.ok == 0) {
    console.log('fails ' + res.fails.map(item => item.what + '@' + item.line).join(', '))
    return
  }
  head = referenceText(file, src)
  ref = ourWordsOf(head.text, head.glued)
  ours = ourWordsOf(normal(ManParse.toText(res.doc.blocks)), head.glued)
  lost = missingWords(ref, ours)
  at = 0
  while ((at < ref.length) && (at < ours.length) && (ref[at] == ours[at]))
    at++
  console.log('words ' + ours.length + ' ours / ' + ref.length + ' man')
  console.log('at    ' + at)
  console.log('ours  ' + JSON.stringify(ours.slice(Math.max(0, at - 3), at + 8)))
  console.log('man   ' + JSON.stringify(ref.slice(Math.max(0, at - 3), at + 8)))
  console.log('lost  ' + lost.missing + '  ' + JSON.stringify(lost.sample))
}

function main
() {
  opts = parseArgs(process.argv.slice(2))

  if (opts.page) {
    detail(opts.page)
    return
  }

  stats = { pages: 0, total: 0, compared: 0, refused: 0, small: 0, noisy: 0, missing: 0, worst: [] }

  {
    let files

    files = []
    walk(opts.root, files, {})
    if (opts.all == 0)
      files = files.filter(file => Path.dirname(Path.dirname(file)) == opts.root)
    if (opts.section)
      files = files.filter(file => Path.basename(Path.dirname(file)) == ('man' + opts.section))
    // readdir order differs between runs and filesystems, so a --max sample has
    // to be sorted to be repeatable. Keep the full count: the sample is not the
    // section, and saying which part was read is the point of the report.
    files.sort()
    stats.total = files.length
    if (opts.max)
      files = files.slice(0, opts.max)
    files.forEach(file => {
                     let out

                     stats.pages++
                     try {
                       out = diffPage(file)
                     }
                     catch (err) {
                       stats.refused++
                       return
                     }
                     if (out.refused) {
                       stats.refused++
                       return
                     }
                     if (out.small) {
                       stats.small++
                       return
                     }
                     stats.compared++
                     if (out.missing == 0)
                       return
                     stats.noisy++
                     stats.missing += out.missing
                     stats.worst.push(out)
                   })
  }

  stats.worst.sort((a, b) => b.missing - a.missing)
  console.log('man-diff')
  console.log('')
  console.log('  pages     ' + stats.pages +
              ((stats.pages < stats.total) ? (' of ' + stats.total + '  (sample; --max 0 for all)') : ''))
  console.log('  compared  ' + stats.compared + '  (refused ' + stats.refused +
              ', too small ' + stats.small + ')')
  console.log('  pages with missing words  ' + stats.noisy +
              '  (' + stats.missing + ' words total)')
  if (stats.worst.length) {
    console.log('')
    console.log('worst:')
    stats.worst.slice(0, opts.list ? 500 : 20).forEach(out => {
                                                        console.log('  ' + String(out.missing).padStart(5) +
                                                                    '  ' + out.file.replace(opts.root, '') +
                                                                    '  ' + JSON.stringify(out.sample))
                                                      })
  }
}

if (process.argv[1] && (Path.resolve(process.argv[1]) == Url.fileURLToPath(import.meta.url)))
  main()
