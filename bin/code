#!/usr/bin/env bash
set -e

BRED="$(dirname "$(realpath "$0")")"
AUTH="$HOME/.local/share/opencode/auth.json"
LOCAL_SHARE="$("$BRED/oc-data-dir" "$PWD")"

ARGS=(-v "$PWD:$PWD")
for m in \
  "$HOME/fresh/main:$HOME/fresh/main" \
  "$HOME/src/review:$HOME/src/review" \
  "$HOME/src/bred:$HOME/src/bred" \
  "$HOME/sessions:$HOME/sessions" \
  "$HOME/src/opencode:$HOME/src/opencode:ro" \
  "$AUTH:/home/node/.local/share/opencode/auth.json:ro" \
  "$HOME/.gitignore:/home/node/.gitignore:ro" \
  "$LOCAL_SHARE:/home/node/.local/share/opencode"; do
  if [ "${m%%:*}" != "$PWD" ]; then
    ARGS+=(-v "$m")
  fi
done

if [ -f "$HOME/.config/opencode/opencode.json" ]; then
  ARGS+=(-v "$HOME/.config/opencode/opencode.json:/home/node/.config/opencode/opencode.json:ro")
fi

exec docker run -it --rm --name "bred-code-tui-$$" \
  "${ARGS[@]}" \
  -e "OPENCODE_CONFIG_CONTENT={\"model\":\"goat/deepseek/deepseek-v4.1-flash\",\"default_agent\":\"plan\"}" \
  -w "$PWD" \
  opencode-bred
