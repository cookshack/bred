#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
// search-sessions <term> [--subagents]
// Search every bred session store under ~/.local/state/bred/code-data-*/
// for <term>; print matching sessions as:  UUID  date  version  project-dir  "title"
// (UUID first, for copy-session). Snippet line shows the term in context;
// rows that only matched in the title or metadata get a note instead.
// Subagent sessions (parent_id set) are excluded unless --subagents is given.

import Fs from 'node:fs'
import Path from 'node:path'
import { DatabaseSync } from 'node:sqlite'

const term = process.argv[2]
const includeSubagents = process.argv.includes('--subagents')
if (!term) {
  console.error('usage: search-sessions <term> [--subagents]')
  process.exit(1)
}

const BASE = Path.join(process.env.HOME, '.local/state/bred')
const LOWER = term.toLowerCase()

function walk
(dir, out) {
  let entries
  try {
    entries = Fs.readdirSync(dir)
  }
  catch {
    return
  }
  for (const name of entries) {
    const p = Path.join(dir, name)
    let st
    try {
      st = Fs.statSync(p)
    }
    catch {
      continue
    }
    if (st.isDirectory())
      walk(p, out)
    else if (name === 'opencode.db')
      out.push(p)
  }
}

function findDbs
() {
  const out = []
  if (!Fs.existsSync(BASE))
    return out
  for (const name of Fs.readdirSync(BASE)) {
    if (name.startsWith('code-data') == 0)
      continue
    if (Fs.statSync(Path.join(BASE, name)).isDirectory() == 0)
      continue
    walk(Path.join(BASE, name), out)
  }
  return out
}

function storeVersion
(dbPath) {
  const rel = Path.relative(BASE, dbPath)
  const m = rel.match(/^code-data(?:-([^/]+))?\//)
  return m ? (m[1] || '0') : '?'
}

function strip
(s) {
  return String(s || '').replace(/\s+/g, ' ').trim()
}

function fmtDate
(ms) {
  if (!ms)
    return ''
  const d = new Date(ms)
  const p = n => String(n).padStart(2, '0')
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
}

// The text of a part as a user/agent would see it. Returns '' for parts
// (step-start/step-finish) that carry no transcript material.
function partText
(d) {
  switch (d.type) {
    case 'text':
      return d.text
    case 'reasoning':
      return d.text
    case 'tool': {
      const st = d.state || {}
      return [ st.title, st.output,
               typeof st.input == 'string' ? st.input
                 : (st.input ? JSON.stringify(st.input) : '') ]
        .filter(Boolean).join('\n')
    }
    case 'patch':
      return (d.files || []).join('\n')
    default:
      return ''
  }
}

// First part whose displayed text contains the term; snippet shows the term
// in context. Returns null when the session only matched elsewhere (title,
// metadata, a step-finish).
function snippetFor
(db, sessionID) {
  const parts = db.prepare('SELECT data FROM part WHERE session_id = ? ORDER BY time_created').all(sessionID)
  for (const p of parts) {
    let d
    try {
      d = JSON.parse(p.data)
    }
    catch {
      continue
    }
    const text = partText(d)
    if (!text)
      continue
    const idx = text.toLowerCase().indexOf(LOWER)
    if (idx < 0)
      continue
    const start = Math.max(0, idx - 70)
    const end = Math.min(text.length, idx + term.length + 90)
    const pre = start > 0 ? '…' : ''
    const post = end < text.length ? '…' : ''
    return `[${d.type}${d.type == 'tool' && d.tool ? ' ' + d.tool : ''}] ${pre}${strip(text.slice(start, end))}${post}`
  }
  return null
}

const rows = []

for (const dbPath of findDbs()) {
  let db
  try {
    db = new DatabaseSync(dbPath, { readOnly: true })
  }
  catch {
    continue
  }
  try {
    const q = db.prepare(`
      SELECT id, title, directory, time_created
      FROM session
      WHERE ${includeSubagents ? '' : 'parent_id IS NULL AND '}
        (title LIKE ?
         OR EXISTS (SELECT 1 FROM part p
                    WHERE p.session_id = session.id AND p.data LIKE ?))
      ORDER BY time_created DESC
    `)
    for (const r of q.all('%' + term + '%', '%' + term + '%'))
      rows.push({ db: dbPath, version: storeVersion(dbPath), snippet: snippetFor(db, r.id), ...r })
  }
  catch {
    // skip unreadable store
  }
  finally {
    db.close()
  }
}

rows.sort((a, b) => (b.time_created || 0) - (a.time_created || 0))

if (rows.length == 0) {
  console.log(`no sessions matching "${term}" under ${BASE}`)
  process.exit(0)
}

for (const r of rows) {
  console.log(`${r.id}\t${fmtDate(r.time_created)}\t${r.version}\t${r.directory || ''}\t"${strip(r.title)}"`)
  if (r.snippet)
    console.log(`    ${r.snippet}`)
  else if (!String(r.title || '').toLowerCase().includes(LOWER))
    console.log('    (matched title/metadata only — no text match)')
}
