#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
// copy-session <uuid> <working-dir>
// Copy one session out of a bred session store into ~/sessions as an
// agent-readable markdown transcript. READ-ONLY on the source: the store is
// opened readonly and never modified or deleted.
//
// The store for <working-dir> is located under
// ~/.local/state/bred/code-data-*/<working-dir>/opencode.db. If the session
// exists in several version stores, the store matching the current bundled
// opencode version is preferred, else the highest version that has it.
//
// Output: ~/sessions/<project-slug>/<timestamp>-<title-slug>.md

import Fs from 'node:fs'
import Path from 'node:path'
import { fileURLToPath } from 'node:url'
import { DatabaseSync } from 'node:sqlite'

const uuid = process.argv[2]
const workingDir = process.argv[3]
const force = process.argv.includes('--force')
if (!uuid || !workingDir) {
  console.error('usage: copy-session <uuid> <working-dir> [--force]')
  process.exit(1)
}

const BRED = Path.resolve(Path.dirname(fileURLToPath(import.meta.url)), '..')
const BASE = Path.join(process.env.HOME, '.local/state/bred')
const OUT = Path.join(process.env.HOME, 'sessions')
const OUTPUT_LIMIT = 4000

let currentVersion = null
try {
  currentVersion = JSON.parse(Fs.readFileSync(Path.join(BRED, 'ext/code/lib/opencode/version.json'))).version
}
catch {
  // unknown current version; fall back to highest found
}

function storeDbs
() {
  const out = []
  if (!Fs.existsSync(BASE))
    return out
  for (const name of Fs.readdirSync(BASE)) {
    if (name.startsWith('code-data') == 0)
      continue
    // versioned: code-data-<ver><workingDir>; unversioned legacy: code-data<workingDir>
    const p = (name == 'code-data')
      ? Path.join(BASE, 'code-data' + workingDir, 'opencode.db')
      : Path.join(BASE, name + workingDir, 'opencode.db')
    if (Fs.existsSync(p))
      out.push({ version: name.slice('code-data'.length).replace(/^-/, '') || '0', path: p })
  }
  return out
}

function storesWith
(stores) {
  const hits = []
  for (const s of stores) {
    let db
    try {
      db = new DatabaseSync(s.path, { readOnly: true })
    }
    catch {
      continue
    }
    try {
      if (db.prepare('SELECT COUNT(*) AS c FROM session_v2 WHERE id = ?').get(uuid).c > 0)
        hits.push(s)
    }
    finally {
      db.close()
    }
  }
  return hits
}

const hits = storesWith(storeDbs())

if (hits.length == 0) {
  console.error(`session ${uuid} not found in any bred store for ${workingDir}`)
  console.error(`(stores under ${BASE}; run search-sessions to find the UUID)`)
  process.exit(1)
}

let store = hits.find(s => s.version == currentVersion) || hits[0]
if (hits.length > 1)
  console.error(`session in ${hits.length} stores (${hits.map(s => s.version).join(', ')}); using ${store.version}`)

// ---- read the session -------------------------------------------------------

const db = new DatabaseSync(store.path, { readOnly: true })

const s = db.prepare('SELECT * FROM session_v2 WHERE id = ?').get(uuid)
const msgs = db.prepare('SELECT id, seq, type, time_created, data FROM session_message WHERE session_id = ? ORDER BY seq').all(uuid)

let firstText = ''
let firstModel = null
{
  const um = msgs.find(x => x.type == 'user')
  if (um) {
    try {
      const d = JSON.parse(um.data)
      if (d.text)
        firstText = d.text.replace(/\s+/g, ' ').trim().slice(0, 100)
    }
    catch {}
  }
  const am = msgs.find(x => x.type == 'assistant')
  if (am) {
    try {
      const d = JSON.parse(am.data)
      if (d.model?.id)
        firstModel = d.model.id
    }
    catch {}
  }
}

// ---- render -----------------------------------------------------------------

function pad
(n) {
  return String(n).padStart(2, '0')
}

function fmtDate
(ms) {
  const d = new Date(ms)
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`
}

function fmtStamp
(ms) {
  const d = new Date(ms)
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}-${pad(d.getHours())}${pad(d.getMinutes())}`
}

function slug
(x) {
  return String(x || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'session'
}

function truncate
(x) {
  x = String(x ?? '')
  if (x.length <= OUTPUT_LIMIT)
    return x
  return x.slice(0, OUTPUT_LIMIT) + `\n… [truncated at ${OUTPUT_LIMIT} chars]`
}

function toolOutput
(st) {
  if (st?.output)
    return st.output
  if (st?.error)
    return st.error.message || JSON.stringify(st.error)
  return (st?.content || []).filter(c => c.type == 'text').map(c => c.text).join('\n')
}

function renderContent
(c, out) {
  if (c.type == 'text') {
    if (c.text)
      out.push(c.text.replace(/\n+$/, ''))
  }
  else if (c.type == 'reasoning') {
    if (c.text)
      out.push(`<details><summary>reasoning</summary>\n\n${c.text}\n\n</details>`)
  }
  else if (c.type == 'tool') {
    const st = c.state || {}
    out.push(`\n### tool: ${c.name}`)
    if (st.input !== undefined) {
      let s
      try { s = typeof st.input == 'string' ? st.input : JSON.stringify(st.input, null, 2) } catch { s = String(st.input) }
      out.push('input:\n```json\n' + truncate(s) + '\n```')
    }
    const output = toolOutput(st)
    if (output)
      out.push('output:\n```text\n' + truncate(output) + '\n```')
  }
}

const lines = []
const title = s.title || firstText || '(untitled)'

lines.push(`# ${title}`)
lines.push('')
lines.push(`- session: ${s.id}`)
lines.push(`- directory: ${s.directory || ''}`)
lines.push(`- created: ${fmtDate(s.time_created)}`)
lines.push(`- agent: ${s.agent || ''}`)
lines.push(`- model: ${firstModel || ''}`)
lines.push(`- copied from: ${store.path}`)
lines.push('')
lines.push('---')
lines.push('')

for (const m of msgs) {
  let d
  try {
    d = JSON.parse(m.data)
  }
  catch {
    continue
  }
  const blocks = []
  if (m.type == 'user') {
    if (d.text)
      blocks.push(d.text.replace(/\n+$/, ''))
  }
  else if (m.type == 'assistant') {
    for (const c of (d.content || []))
      renderContent(c, blocks)
  }
  else if (d.text)
    blocks.push(d.text)
  lines.push(`## ${m.type || '?'} · ${fmtDate(m.time_created)}`)
  lines.push('')
  lines.push(blocks.length ? blocks.join('\n\n') : '_(no content)_')
  lines.push('')
}

db.close()

// ---- write ------------------------------------------------------------------

const projectDir = Path.join(OUT, slug(Path.basename(workingDir)))
const file = Path.join(projectDir, `${fmtStamp(s.time_created)}-${slug(title)}.md`)

if (Fs.existsSync(file) && !force) {
  console.error(`❌ already exists: ${file}`)
  console.error('   (not overwritten; pass --force to replace it)')
  process.exit(1)
}

Fs.mkdirSync(projectDir, { recursive: true })
Fs.writeFileSync(file, lines.join('\n'))

const size = Fs.statSync(file).size
if (size == 0) {
  console.error(`error: wrote empty file ${file}`)
  process.exit(1)
}

console.log(`copied ${uuid} (${title}) -> ${file} (${size} bytes)`)
