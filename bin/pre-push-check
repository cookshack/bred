#!/bin/bash
# The push gate: skip when this tree is already verified, else run the checks.
# --full runs everything and stamps the tree; --quiet logs without the noise;
# --stamp writes the stamp for a tree another gate already verified (a loop
# land, whose round ran check and the full suite at the recorded tip).

set +e

mode=e2e
quiet=0

for arg in "$@"; do
  case "$arg" in
    --full) mode=full ;;
    --stamp) mode=stamp ;;
    --quiet) quiet=1 ;;
  esac
done

root=$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")
tree=$(git rev-parse --show-toplevel)
log="$root/.pre-push.log"
stampFull="$root/.pre-push.stamp"
stampE2e="$root/.pre-push-e2e.stamp"

cd "$tree" || exit 2

key() {
  {
    git rev-parse HEAD
    git status --porcelain
    cat "$tree/.bred-module-hash" 2>/dev/null || echo no-module-hash
    node -v | cut -d. -f1
    echo checks-v1
  } | sha256sum | cut -d' ' -f1
}

runLogged() {
  if [ "$quiet" = 1 ]; then
    "$@" 2>&1 | tee -a "$log" > /dev/null
  else
    "$@" 2>&1 | tee -a "$log"
  fi
  return ${PIPESTATUS[0]}
}

verified() {
  printf 'skipped: tree verified (%s)\n== exit 0\n' "$1" >> "$log"
  if [ "$quiet" = 1 ]; then
    echo "verify: tree already verified ($1)"
  fi
  exit 0
}

printf '== %s %s %s %s\n' "$(date -Is)" "$(git rev-parse --abbrev-ref HEAD)" "$(git log -1 --format='%h %s')" "$mode" > "$log"

if [ "$quiet" = 1 ]; then
  echo "verify: running $mode checks"
fi

k=$(key)

if [ "$mode" = stamp ]; then
  printf '%s' "$k" > "$stampFull"
  if [ "$quiet" = 1 ]; then
    echo "verify: stamped (loop land)"
  fi
  exit 0
fi

if [ -f "$stampFull" ] && [ "$(cat "$stampFull")" = "$k" ]; then
  verified full
fi

if [ "$mode" = e2e ] && [ -f "$stampE2e" ] && [ "$(cat "$stampE2e")" = "$k" ]; then
  verified e2e
fi

if [ "$mode" = full ]; then
  runLogged npm run check
  status=$?
  if [ "$status" = 0 ]; then
    runLogged npm test
    status=$?
  fi
else
  runLogged "$tree/bin/run-tests" "$tree"/test/*e2e*.mjs
  status=$?
fi

if [ "$status" = 0 ]; then
  if [ "$mode" = full ]; then
    printf '%s' "$k" > "$stampFull"
  else
    printf '%s' "$k" > "$stampE2e"
  fi
fi

printf '== exit %s\n' "$status" >> "$log"

if [ "$quiet" = 1 ]; then
  if [ "$status" = 0 ]; then
    echo "verify: ok ($mode)"
  else
    echo "verify: FAILED ($mode), see $log"
  fi
fi

exit "$status"
