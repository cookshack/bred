div.man-doc
  h2.man-h1
    span
      "NAME"
  p
    span
      "table - aligned cells and a span"
  h2.man-h1
    span
      "DESCRIPTION"
  table.man-table
    tbody
      tr
        td.man-left
          span
            "name"
        td.man-right
          span
            "count"
        td.man-left
          span
            "note"
      tr
        td.man-left
          span
            "alpha"
        td.man-right
          span
            "1"
        td.man-left
          span
            "first"
      tr
        td.man-left
          span
            "beta"
        td.man-right
          span
            "22"
        td.man-left
          span
            "second"
  div.man-space
